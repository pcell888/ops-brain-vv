# PostgreSQL (LangGraph checkpointer + tenant_registry)
POSTGRES_URI=postgresql://postgres:password@localhost:5432/ops_brain

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM
LLM_API_KEY=sk-xxx
LLM_MODEL=qwen-max
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# LangSmith（https://smith.langchain.com；LANGSMITH_* 与 LANGCHAIN_* 任选一套）
# LANGSMITH_TRACING_V2=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=ops-brain
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=ops-brain

# AES encryption key for tenant credentials (base64 encoded, 32 bytes)
CREDENTIAL_ENCRYPT_KEY=base64-encoded-32-byte-key

# 平台中台（不入库；诊断里 benchmark 等企业态调用仍走各租户的 platform_auth_credential）
PLATFORM_CENTER_API_BASE=https://platform-center.wlwq.com/api
PLATFORM_CENTER_AUTH_TYPE=token
# 仅当调用中台且未指定企业上下文时的兜底；一般用企业 platform_auth_credential 即可留空
PLATFORM_CENTER_AUTH_CREDENTIAL=

# wlwq 模拟业务系统 — MySQL (供 MCP 调用的企业服务)
WLWQ_MYSQL_HOST=192.168.1.249
WLWQ_MYSQL_PORT=3306
WLWQ_MYSQL_USER=wlwq
WLWQ_MYSQL_PASSWORD=Mysql@db$123!
WLWQ_MYSQL_DATABASE=wlwq-enterprise-service

# MCP：由 Agent/API 进程内 stdio 子进程拉起（python -m src.mcp_servers.*），无需独立 URL

# 前端（docker compose：默认多阶段构建 + nginx；本地热更新加 -f docker-compose.dev.yml）
# FRONTEND_PORT=3000
# OPS_BRAIN_API_PORT 需与 nginx 反代 API_UPSTREAM_PORT 一致（默认 8000）
# 镜像构建时可选：静态资源直连独立 API / WS 域名时设置
# VITE_API_URL 必须是后端前缀，以 /api/v1 结尾；勿填成 SPA 子路径（否则会请求成 /diagnose/tracking/... 导致 404）
# VITE_API_URL=https://ai.example.com/api/v1
# VITE_WS_URL=wss://ai.example.com
# 反代在子路径时用 VITE_BASE_PATH（SPA）；与 VITE_API_URL 无关
# VITE_BASE_PATH=diagnose-admin
