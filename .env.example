# PostgreSQL (LangGraph checkpointer + tenant_registry)
POSTGRES_URI=postgresql://postgres:password@localhost:5432/ops_brain

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM
LLM_API_KEY=sk-xxx
LLM_MODEL=qwen-max
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# AES encryption key for tenant credentials (base64 encoded, 32 bytes)
CREDENTIAL_ENCRYPT_KEY=base64-encoded-32-byte-key

# wlwq 模拟业务系统 — MySQL (供 MCP 调用的企业服务)
WLWQ_MYSQL_HOST=192.168.1.249
WLWQ_MYSQL_PORT=3306
WLWQ_MYSQL_USER=wlwq
WLWQ_MYSQL_PASSWORD=Mysql@db$123!
WLWQ_MYSQL_DATABASE=wlwq-enterprise-service

# MCP Server URLs
MCP_METRICS_URL=http://localhost:8100/sse
MCP_CRM_URL=http://localhost:8101/sse
MCP_BENCHMARK_URL=http://localhost:8102/sse
MCP_TASK_URL=http://localhost:8103/sse
MCP_NOTIFY_URL=http://localhost:8104/sse
